PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/chatapp
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Dev-only DB reset guard
DEV_RESET_SECRET=your_dev_reset_secret_here

# 100% Free Email OTP via Gmail SMTP (Google App Password)
# Generate from: Google Account -> Security -> 2-Step Verification -> App passwords
EMAIL_USER=your_email@gmail.com
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Optional fallback SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 100% Free SMS OTP via Fast2SMS Dev API
# Sign up free at https://www.fast2sms.com to get your free dev API key
FAST2SMS_API_KEY=

# Optional Twilio SMS configuration
SMS_PROVIDER=fast2sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
